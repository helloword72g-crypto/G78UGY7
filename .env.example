# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead
# (DATABASE_URL is set automatically if you deploy via render.yaml).

# Password to log into /admin
ADMIN_PASSWORD=changeme123

# Random long string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# Port the server listens on (Render sets this automatically)
PORT=3000

# PostgreSQL connection string.
# Format: postgresql://username:password@host:port/database
# - Local Postgres example: postgresql://postgres:postgres@localhost:5432/crypto_sultan
# - Render Postgres: copy the "External Database URL" from your Render Postgres dashboard
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_sultan

# Set to "disable" only for a local Postgres that doesn't use SSL.
# Leave unset (or anything else) for Render Postgres, which requires SSL.
# PGSSLMODE=disable

# Optional defaults used only the very first time the database is created
DEFAULT_WHATSAPP_NUMBER=91XXXXXXXXXX
DEFAULT_RATE=97.53
DEFAULT_SITE_NAME=Crypto Sultan
